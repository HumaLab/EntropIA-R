linters: linters_with_defaults(
    line_length_linter(100L),
    object_name_linter(styles = c("snake_case", "symbols", "SCREAMING_SNAKE")),
    indentation_linter = NULL
  )
exclusions: list(
  "tests/testthat/fixtures",
  "tests/testthat" = list(object_usage_linter = Inf),
  "data-raw" = list(object_usage_linter = Inf)
  )
encoding: "UTF-8"
