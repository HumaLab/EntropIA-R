> load_all("G:/EntropIA-Stack/EntropIA-R", quiet = TRUE)
> 
> con <- entropia_connect("G:/EntropIA-Stack/EntropIA-R/tests/testthat/fixtures/full.sqlite")
> 
> cat("=== Filtered corpus (collections) plan ===\n")
=== Filtered corpus (collections) plan ===
> t <- entropia_corpus(con, collections = "Collection One")
> sql <- as.character(dbplyr::sql_render(t))
> cat(sql, "\n")
SELECT
  `item_id`,
  `item_title`,
  `collection_id`,
  `metadata`,
  `item_created_at`,
  `item_updated_at`,
  `collection_name`,
  `collection_description`,
  `collection_created_at`,
  `collection_updated_at`,
  `asset_id`,
  `asset_path`,
  `asset_type`,
  `asset_size`,
  `asset_created_at`,
  `asset_sort_index`,
  `parent_asset_id`,
  `page_number`,
  COALESCE(`text_ext`, `text_trx`) AS `text`
FROM (
  SELECT
    `items`.`id` AS `item_id`,
    `title` AS `item_title`,
    `collection_id`,
    `metadata`,
    `items`.`created_at` AS `item_created_at`,
    `items`.`updated_at` AS `item_updated_at`,
    `name` AS `collection_name`,
    `description` AS `collection_description`,
    `collections`.`created_at` AS `collection_created_at`,
    `collections`.`updated_at` AS `collection_updated_at`,
    `assets`.`id` AS `asset_id`,
    `path` AS `asset_path`,
    `type` AS `asset_type`,
    `size` AS `asset_size`,
    `assets`.`created_at` AS `asset_created_at`,
    `sort_index` AS `asset_sort_index`,
    `parent_asset_id`,
    `page_number`,
    `extractions`.`text_content` AS `text_ext`,
    `transcriptions`.`text_content` AS `text_trx`
  FROM `items`
  LEFT JOIN `collections`
    ON (`items`.`collection_id` = `collections`.`id`)
  LEFT JOIN `assets`
    ON (`items`.`id` = `assets`.`item_id`)
  LEFT JOIN `extractions`
    ON (`assets`.`id` = `extractions`.`asset_id`)
  LEFT JOIN `transcriptions`
    ON (`assets`.`id` = `transcriptions`.`asset_id`)
) AS `q01`
WHERE (`collection_name` IN ('Collection One')) 
