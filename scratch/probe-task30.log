=== EXPLAIN QUERY PLAN: search items ===
> search_tbl <- entropia_search(con, "huelga", index = "items")
> search_sql <- as.character(dbplyr::sql_render(search_tbl))
> cat(search_sql, "\n")
SELECT i.*, bm25(fts_items) AS rank
FROM fts_items
JOIN items i ON i.rowid = fts_items.rowid
WHERE fts_items MATCH 'huelga'
ORDER BY rank 
> plan4 <- DBI::dbGetQuery(con, paste0("EXPLAIN QUERY PLAN ", search_sql))
