=== EXPLAIN QUERY PLAN: corpus join (no text) ===
> corpus_tbl <- entropia_corpus(con, text = FALSE)
> corpus_sql <- as.character(dbplyr::sql_render(corpus_tbl))
> cat(corpus_sql, "\n")
SELECT
  `items`.`id` AS `item_id`,
  `title` AS `item_title`,
  `collection_id`,
  `metadata`,
  `items`.`created_at` AS `item_created_at`,
  `items`.`updated_at` AS `item_updated_at`,
  `name` AS `collection_name`,
  `description` AS `collection_description`,
  `collections`.`created_at` AS `collection_created_at`,
  `collections`.`updated_at` AS `collection_updated_at`,
  `assets`.`id` AS `asset_id`,
  `path` AS `asset_path`,
  `type` AS `asset_type`,
  `size` AS `asset_size`,
  `assets`.`created_at` AS `asset_created_at`,
  `sort_index` AS `asset_sort_index`,
  `parent_asset_id`,
  `page_number`
FROM `items`
LEFT JOIN `collections`
  ON (`items`.`collection_id` = `collections`.`id`)
LEFT JOIN `assets`
  ON (`items`.`id` = `assets`.`item_id`) 
