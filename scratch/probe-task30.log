SELECT
  `id`,
  `asset_id`,
  `item_id`,
  `source_kind`,
  `source_id`,
  `chunk_ordinal`,
  `text_content`,
  `start_char`,
  `end_char`,
  `source_text_hash`,
  `chunking_contract`,
  `embedding_model`,
  `embedding_contract`,
  `dimensions`,
  `rank`
FROM (
SELECT c.*, bm25(rag_chunks_fts) AS rank
FROM rag_chunks_fts
JOIN rag_chunks c ON c.id = rag_chunks_fts.chunk_id
WHERE rag_chunks_fts MATCH 'huelga'
ORDER BY rank
) AS `q01` 
